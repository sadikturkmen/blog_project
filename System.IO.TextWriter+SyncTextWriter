@import url('https://fonts.googleapis.com/css2?family=Momo+Trust+Display&family=Momo+Trust+Sans:wght@200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');

:root {
  --primary-color: #4CAF50;
  --secondary-color: #ff9800;
  --font-color: #333333;
  --background-color: #f5f5f5;
  --font-size-base: 1rem;
  --font-size-md: clamp(1.25rem, 0.61vw + 1.1rem, 1.58rem);
  --font-size-lg: clamp(1.56rem, 1vw + 1.31rem, 2.11rem);
  --font-size-xl: clamp(2.44rem, 2.38vw + 1.85rem, 3.75rem);
  --border-radius: 10px;
}

body{
  font-family: "Poppins", sans-serif;
  color: var(--font-color);
  font-size: var(--font-size-base);
  background-color: var(--background-color);
  background-image: url("/img/arka_plan.png");
  margin: 0;
}

a {color: var(--primary-color); }
h1 { font-size: var(--font-size-xl);}
h2 { font-size: var(--font-size-lg);}
h3 { font-size: var(--font-size-md );}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="search"],
select
textarea {
  font-family: "Momo Trust Sans", sans-serif;
  font-size: var(--font-size-base);
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 0.7rem 0.75rem;
  margin-bottom: 1rem;
}

.btn {
    background-color: var(--primary-color);
    border: none;
    color: white;
    padding: 16px 32px;
    text-decoration: none;
    margin: 4px 2px;
    cursor: pointer;
}

.btn-delete {
    padding: 10px 16px;
    background-color: var(--secondary-color);
}


img {
  width: 100%;
  height: auto;
}


/* Hizalama kismi */
.container {
  max-width: 982px;
  margin: 0 auto;
  padding: 0 10px;
}

.main {
  padding: 20px 0;
}

/* Hero Section */
.hero-image {
  max-height: 528px;
  filter: drop-shadow(0px 44px 34px rgba(0,0,0,0.25));
  overflow: hidden;
  border-radius: var(--border-radius);
}  

/* Ana Basliklar */
.header {
  display: grid;
  align-items: center;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto;
  padding-top: 10px;
  grid-template-areas: 
    "logo button"
    "menu menu";
}


@media only screen and (min-width: 768px) {
  .header {
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "logo menu button";
  }
}

.header-logo {
  grid-area: logo;
  font-weight: 800;
  font-size: 25px;
  text-decoration: none;
}

.header__logo:hover {
  text-decoration: underline;
}

.header__nav {
  display: flex;
  justify-content: center;
  grid-area: menu;
}


.header__button {
  display: flex;
  justify-content: end;
  grid-area: button;
}

.header__button button {
  display: flex;
  gap: 0.3rem;
  align-items: center;
  border: 0;
  padding: 6px 12px;
  background: none;
  border-radius: var(--border-radius);
  border: 2px solid transparent;
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--black);
}

.header__button button:hover {
  border: 2px solid var(--font-color);
}

/* header nav linkleri */
.header__nav ul {
  list-style: none;
  display: flex;
  gap: 1rem;
  font-weight: 600;
  padding: 0;
}

.header__nav ul a {
  text-decoration: none;
  padding: 10px;
}

.header__nav ul a:hover {
  text-decoration: underline;
}

.header__nav ul a.active {
  color: var(--primary-color);
}

/* author - anasayfa */
.author {
  padding: 10px 0;
  text-align: center;
} 

.author__heading {
  margin-top: 10px;
  margin-bottom: 5px;
}

